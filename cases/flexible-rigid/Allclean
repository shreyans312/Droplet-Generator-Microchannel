#!/bin/bash
set -eu
cd "${0%/*}"

for case_name in rigid flexible; do
    rm -rf "$case_name"/0.[0-9]* "$case_name"/[1-9]*
    rm -rf "$case_name/constant/polyMesh" "$case_name/postProcessing"
    rm -f "$case_name/0"/alpha.oil_background "$case_name/0"/alpha.oil_liquidCore
    rm -f "$case_name"/*.foam
    cp common/alpha.water.initial "$case_name/0/alpha.water"
    rm -f "$case_name"/log.*
done
